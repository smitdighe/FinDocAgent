# --- core ---
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://findoc:findoc@localhost:5433/findoc
# Directory for raw filings, rendered PDFs and page images
STORAGE_DIR=./data
# Public object-store base URL for page JPEGs (e.g. Cloudflare R2 public bucket,
# https://pub-xxxx.r2.dev). Set in prod where the disk is ephemeral; the image
# endpoint 307-redirects here. Empty = serve local files from STORAGE_DIR (dev).
IMAGE_PUBLIC_BASE_URL=
# Allowed browser origins for CORS (comma-separated, no trailing slash).
# Empty/unset falls back to the localhost dev defaults. In prod set this to the
# deployed frontend origin, e.g. https://findoc-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- LLM provider (groq | vllm | openai) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# vLLM is a local-only adapter; point at your local OpenAI-compatible server
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# optional third provider proving the abstraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- embeddings (ColPali family, 128-dim multi-vectors) ---
COLPALI_MODEL=vidore/colqwen2-v1.0
# auto | cuda | cpu | mps
COLPALI_DEVICE=auto
# Load ColPali in the API process to embed queries at request time. Keep false
# in prod / on CPU-only hosts: the API serves precomputed page vectors and
# retrieval degrades to FTS when off (see app/agents/retrieval.py).
QUERY_EMBEDDING=false

# --- EDGAR (SEC requires a descriptive User-Agent with contact info) ---
EDGAR_USER_AGENT=FinDocAgent/0.1 (your-name your-email@example.com)

# --- rate limiting ---
RATE_LIMIT_QUERY=20/minute

# --- observability (phase 5; leave empty to disable) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- rendering ---
RENDER_DPI=150
