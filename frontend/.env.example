# Base URL of the FinDocAgent backend.
# Leave EMPTY in local dev — Vite's proxy (vite.config.ts) forwards /filings,
# /query, /eval, /stats to http://localhost:8000 so the browser talks
# same-origin (no CORS needed).
# In production set this in the Vercel dashboard (Project > Settings > Environment
# Variables) to the deployed Render backend origin — no trailing slash, e.g.
#   VITE_API_BASE_URL=https://findoc-backend.onrender.com
# It is baked in at BUILD time (Vite inlines VITE_* vars), so changing it
# requires a redeploy on Vercel.
VITE_API_BASE_URL=
